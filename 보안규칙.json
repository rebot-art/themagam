      "$id": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['user','msg','time']) && newData.child('user').isString() && newData.child('user').val().length <= 40 && newData.child('msg').isString() && newData.child('msg').val().length >= 1 && newData.child('msg').val().length <= 2000 && newData.child('time').isNumber() && root.child('nickOwner').child(newData.child('user').val()).val() === auth.uid"
      }
    },
    "worktime": {
      ".read": true,
      "$day": {
        "$nick": {
          ".write": "auth != null && (root.child('nickOwner').child($nick).val() === auth.uid || auth.uid === 'ABM1ZJndrqaV3gpYUs03SV9qglr1')",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440"
        },
        ".write": "auth != null && auth.uid === 'ABM1ZJndrqaV3gpYUs03SV9qglr1' && !newData.exists()"
      }
    },
    "sreactions": {
      ".read": "auth != null && (auth.uid === 'ABM1ZJndrqaV3gpYUs03SV9qglr1' || root.child('sallow').child(auth.uid).exists())",
      ".write": "auth != null && auth.uid === 'ABM1ZJndrqaV3gpYUs03SV9qglr1'",
      "$msg": {
        "$rid": {
          "$nick": {
            ".write": "auth != null && (auth.uid === 'ABM1ZJndrqaV3gpYUs03SV9qglr1' || root.child('sallow').child(auth.uid).exists()) && root.child('nickOwner').child($nick).val() === auth.uid",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    }
  }
}